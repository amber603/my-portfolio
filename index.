                        <pre><code class="language-r"># Chart rendering (based on individual_data)
p_individual <- ggplot(individual_data, aes(x = Week, y = Per_Average,
                                      group = Participant_ID)) +
  geom_line(alpha = 0.6, linewidth = 0.8, color = "grey") +
